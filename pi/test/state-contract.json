{
  "schema": "amq-squad-state-contract/1",
  "task": {
    "states": [
      {
        "name": "pending",
        "terminal": false
      },
      {
        "name": "in_progress",
        "terminal": false
      },
      {
        "name": "blocked",
        "terminal": false
      },
      {
        "name": "completed",
        "terminal": true
      },
      {
        "name": "cancelled",
        "terminal": true
      }
    ],
    "moves": [
      {
        "from": "",
        "via": [
          "Add",
          "AddWithFileWaits"
        ],
        "writer": "AddWithFileWaits",
        "to": "pending",
        "who": [
          "asserted_handle"
        ],
        "clears_block_group": false
      },
      {
        "from": "pending",
        "via": [
          "Grant",
          "GrantClean",
          "Claim",
          "ClaimServing"
        ],
        "writer": "grant",
        "to": "in_progress",
        "who": [
          "scheduler",
          "asserted_handle"
        ],
        "clears_block_group": false
      },
      {
        "from": "pending",
        "via": [
          "Block",
          "BlockWithPaths"
        ],
        "writer": "block",
        "to": "blocked",
        "who": [
          "scheduler",
          "asserted_handle"
        ],
        "clears_block_group": false
      },
      {
        "from": "pending",
        "via": [
          "Cancel"
        ],
        "writer": "Cancel",
        "to": "cancelled",
        "who": [
          "asserted_handle"
        ],
        "clears_block_group": false
      },
      {
        "from": "in_progress",
        "via": [
          "Done"
        ],
        "writer": "complete",
        "to": "completed",
        "who": [
          "live_holder"
        ],
        "needs": "Done has no prior report and no declared files; when a verdict is required or a sealed verdict is present, that verdict passes",
        "clears_block_group": true
      },
      {
        "from": "in_progress",
        "via": [
          "Complete",
          "CompleteBound"
        ],
        "writer": "complete",
        "to": "completed",
        "who": [
          "scheduler",
          "harness_shell"
        ],
        "needs": "a report exists; CompleteBound also has a nonnegative PR number and, when positive, a valid free binding; when a verdict is required or a sealed verdict is present, that verdict passes",
        "clears_block_group": true
      },
      {
        "from": "in_progress",
        "via": [
          "Done",
          "Complete",
          "CompleteBound"
        ],
        "writer": "block",
        "to": "blocked",
        "who": [
          "live_holder",
          "scheduler",
          "harness_shell"
        ],
        "needs": "Done has no prior report and no declared files; Complete and CompleteBound have a report, and CompleteBound has a valid free binding; a verdict is required but absent, or a sealed verdict is present and does not pass",
        "clears_block_group": false
      },
      {
        "from": "in_progress",
        "via": [
          "RefuseCommit",
          "RefuseCommitPaths"
        ],
        "writer": "block",
        "to": "blocked",
        "who": [
          "scheduler",
          "harness_shell"
        ],
        "needs": "paths are exact, a report exists, the route is empty, lead, or owner, and the reason code is non-empty",
        "clears_block_group": false
      },
      {
        "from": "in_progress",
        "via": [
          "Block",
          "BlockWithPaths"
        ],
        "writer": "block",
        "to": "blocked",
        "who": [
          "live_holder"
        ],
        "clears_block_group": false
      },
      {
        "from": "in_progress",
        "via": [
          "Fail"
        ],
        "writer": "Fail",
        "to": "pending",
        "who": [
          "live_holder"
        ],
        "clears_block_group": false
      },
      {
        "from": "in_progress",
        "via": [
          "Release"
        ],
        "writer": "Release",
        "to": "pending",
        "who": [
          "asserted_handle"
        ],
        "clears_block_group": false
      },
      {
        "from": "in_progress",
        "via": [
          "ExpireDue"
        ],
        "writer": "ExpireDue",
        "to": "pending",
        "who": [
          "scheduler"
        ],
        "needs": "no report; the lease is due",
        "clears_block_group": false
      },
      {
        "from": "in_progress",
        "via": [
          "Cancel"
        ],
        "writer": "Cancel",
        "to": "cancelled",
        "who": [
          "asserted_handle"
        ],
        "clears_block_group": false
      },
      {
        "from": "blocked",
        "via": [
          "ResetBy"
        ],
        "writer": "ResetBy",
        "to": "pending",
        "who": [
          "creator",
          "asserted_handle"
        ],
        "needs": "the caller is non-empty, the route is not owner, and the caller matches the creator when recorded; when no creator is recorded, any non-empty caller is accepted",
        "clears_block_group": true
      },
      {
        "from": "blocked",
        "via": [
          "Reset"
        ],
        "writer": "Reset",
        "to": "pending",
        "who": [
          "scheduler"
        ],
        "clears_block_group": true
      },
      {
        "from": "blocked",
        "via": [
          "ResetIfBlocked"
        ],
        "writer": "ResetIfBlocked",
        "to": "pending",
        "who": [
          "scheduler"
        ],
        "needs": "the block reason matches, and the optional match function is absent or accepts the task",
        "clears_block_group": true
      },
      {
        "from": "blocked",
        "via": [
          "Widen",
          "WidenGated"
        ],
        "writer": "WidenGated",
        "to": "pending",
        "who": [
          "proven_lead"
        ],
        "needs": "added paths and their union are valid and non-empty, reason and actor are non-empty, actor is not holder or reporter, no active file conflicts, and the task has no report, refused paths, and a widen-request reason",
        "clears_block_group": true
      },
      {
        "from": "blocked",
        "via": [
          "Widen",
          "WidenGated"
        ],
        "writer": "WidenGated",
        "to": "in_progress",
        "who": [
          "proven_lead"
        ],
        "needs": "added paths and their union are valid and non-empty, reason and actor are non-empty, actor is not holder or reporter, no active file conflicts, and a report exists",
        "clears_block_group": true
      },
      {
        "from": "blocked",
        "via": [
          "Escalate"
        ],
        "writer": "block",
        "to": "blocked",
        "who": [
          "proven_lead"
        ],
        "needs": "the reason code is non-empty",
        "clears_block_group": false
      },
      {
        "from": "blocked",
        "via": [
          "Cancel"
        ],
        "writer": "Cancel",
        "to": "cancelled",
        "who": [
          "asserted_handle"
        ],
        "clears_block_group": false
      }
    ],
    "outcomes": [
      "completed",
      "unclaimed",
      "expired",
      "failed",
      "released",
      "blocked",
      "cancelled",
      "commit_refused"
    ],
    "routes": [
      "lead",
      "owner"
    ],
    "block_group": [
      "block_reason",
      "block_route",
      "block_detail",
      "block_attempt",
      "refused_paths"
    ],
    "outcome_sets": [
      {
        "name": "retry_budget",
        "reader_package": "internal/scheduler",
        "reader_func": "DefaultRouter.Route",
        "outcomes": [
          "failed",
          "expired"
        ]
      },
      {
        "name": "router_retry_effect",
        "reader_package": "internal/routing",
        "reader_func": "effect",
        "outcomes": [
          "failed",
          "expired",
          "commit_refused",
          "blocked"
        ],
        "conditional": [
          {
            "outcome": "commit_refused",
            "condition": "the attempt detail is classified true in RefusalWorkFailure"
          },
          {
            "outcome": "blocked",
            "condition": "the attempt detail is classified true in RefusalWorkFailure, or is unclassified (blocked defaults to a work failure)"
          }
        ]
      },
      {
        "name": "weekly_report_failed",
        "reader_package": "internal/routing",
        "reader_func": "failedOutcome",
        "outcomes": [
          "failed",
          "expired",
          "commit_refused",
          "blocked"
        ]
      },
      {
        "name": "verifier_fail",
        "reader_package": "internal/routing",
        "reader_func": "verifierResult",
        "outcomes": [
          "failed",
          "commit_refused",
          "blocked"
        ],
        "conditional": [
          {
            "outcome": "failed",
            "condition": "the verifier is mechanical and the attempt has no verdict"
          },
          {
            "outcome": "commit_refused",
            "condition": "the verifier is mechanical and the attempt has no verdict"
          },
          {
            "outcome": "blocked",
            "condition": "the verifier is mechanical, the attempt has no verdict, and the detail is not verdict_missing"
          }
        ]
      },
      {
        "name": "exit_scan",
        "reader_package": "internal/scheduler",
        "reader_func": "scanAttemptsLog",
        "outcomes": [
          "failed",
          "expired",
          "unclaimed"
        ]
      },
      {
        "name": "seat_lapsed",
        "reader_package": "internal/scheduler",
        "reader_func": "idleSeatExcept",
        "outcomes": [
          "unclaimed",
          "expired"
        ]
      }
    ]
  }
}
